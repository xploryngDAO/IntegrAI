{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "title": "RPS (5m)",
      "targets": [
        {
          "expr": "sum(rate(sac_http_requests_total[5m]))",
          "legendFormat": "requests/s",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "title": "5xx (5m)",
      "targets": [
        {
          "expr": "sum(rate(sac_http_requests_total{status_class=\"5xx\"}[5m]))",
          "legendFormat": "5xx/s",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "title": "Latência p95 (5m)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le)(rate(sac_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 8 },
      "id": 4,
      "title": "API up",
      "targets": [{ "expr": "up{job=\"sachub-api\"}", "refId": "A" }],
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 8 },
      "id": 5,
      "title": "Postgres up (readiness)",
      "targets": [{ "expr": "sac_db_up", "refId": "A" }],
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 8 },
      "id": 6,
      "title": "Redis up (readiness)",
      "targets": [{ "expr": "sac_redis_up", "refId": "A" }],
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 8 },
      "id": 7,
      "title": "Storage up (readiness)",
      "targets": [{ "expr": "sac_storage_up", "refId": "A" }],
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 13 },
      "id": 8,
      "title": "Uptime do processo",
      "targets": [{ "expr": "sac_process_uptime_seconds", "refId": "A" }],
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 13 },
      "id": 9,
      "title": "Por classe de status",
      "targets": [
        {
          "expr": "sum by (status_class)(rate(sac_http_requests_total[5m]))",
          "legendFormat": "{{status_class}}",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    }
  ],
