###############################################################################
# SAC Hub - environment template. Copy to .env and fill in real credentials.
# Never commit .env. All *_enc columns are AES-256-GCM encrypted at rest with
# ENCRYPTION_MASTER_KEY (base64, 32 bytes) and a key id for rotation.
###############################################################################

NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173

# ----------------------------- Datastores ------------------------------------
DATABASE_URL=postgresql://sac:sac@127.0.0.1:5432/sac_hub?schema=public
REDIS_URL=redis://127.0.0.1:6379

# ----------------------------- Object storage --------------------------------
# Amazon S3 in production; MinIO locally (path-style URLs required).
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=sac-hub-raw
S3_ATTACHMENTS_BUCKET=sac-hub-attachments
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_SSE=  # e.g. AES256 or aws:kms in production

# ----------------------------- Security --------------------------------------
# 32-byte base64 key. Generate: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=zJ8kQ2mWv7bT1yN5cR9pLx4hF6dA0gU3sE2iO8qK5wY=
ENCRYPTION_KEY_ID=local-dev-v1
JWT_SECRET=dev-only-change-me-please-32-chars-min
JWT_EXPIRES_IN=12h
# Redis-presence TTL for agents (seconds)
AGENT_PRESENCE_TTL=120

# ----------------------------- Amazon SP-API / SES ---------------------------
# LWA application credentials (one app per seller environment).
AMAZON_LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
AMAZON_LWA_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxx
AMAZON_SPAPI_ENDPOINT=https://sellingpartnerapi-na.amazon.com
AMAZON_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_RDT_ENDPOINT=https://sellingpartnerapi-na.amazon.com/tokens/2021-03-01/restrictedDataToken
# Region for the seller (na | eu | fe).
AMAZON_SPAPI_REGION=na
# Shared secret used to authenticate SES -> HTTP inbound relay. The relay signs
# the raw .eml body with HMAC-SHA256 and sends it in x-sac-signature.
AMAZON_SES_INBOUND_SHARED_SECRET=change-me-ses-inbound-secret
# Sender identities are per-account (channel_config.smtp_sender_email), verified
# in Seller Central. This is the transport used for Amazon Route 1 (SMTP relay).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Amazon prohibits sellers from using SES to email buyers directly; production
# must use the seller's approved SMTP relay (Seller Central > Messaging).
AMAZON_EMAIL_DOMAIN_ALLOWLIST=amazon.com,amazon.com.br

# ----------------------------- Mercado Livre ---------------------------------
MELI_CLIENT_ID=1234567890
MELI_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MELI_REDIRECT_URI=http://localhost:4000/api/v1/accounts/oauth/mercadolivre/callback
MELI_API_BASE=https://api.mercadolibre.com
# Meli refresh tokens rotate: the refresh window is 6h, we refresh at 5h45m.
MELI_REFRESH_INTERVAL_SECONDS=20700
MELI_WEBHOOK_TOPICS=questions,messages,claims,post_purchase,orders,shipments

# ----------------------------- Shopee Open Platform v2 ----------------------
SHOPEE_PARTNER_ID=1000000
SHOPEE_PARTNER_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPEE_REDIRECT_URI=http://localhost:4000/api/v1/accounts/oauth/shopee/callback
SHOPEE_API_BASE=https://partner.shopeemobile.com
# Shopee refresh tokens are single-use; refresh every 3h30m under a Redlock.
SHOPEE_REFRESH_INTERVAL_SECONDS=12600
# Lost-push recovery cron (v2.push.get_lost_push_message), every 5 minutes.
SHOPEE_LOST_PUSH_CRON="*/5 * * * *"
SHOPEE_LOST_PUSH_LOOKBACK_MINUTES=60
# Partner-level webhook signature tolerance (seconds) - guards clock drift.
SHOPEE_WEBHOOK_TOLERANCE_SECONDS=300

# ----------------------------- Rate limits (token buckets) ------------------
# Amazon messaging: 1 req/s per order action. SP-API Orders: burst 10, refill 0.5/s
RL_AMAZON_MESSAGING_PER_SECOND=1
RL_AMAZON_ORDERS_PER_SECOND=0.5
RL_AMAZON_ORDERS_BURST=10
RL_MELI_PER_SECOND=10
RL_SHOPEE_PER_SECOND=5

# ----------------------------- SLA / operations -----------------------------
SLA_SCAN_CRON="*/1 * * * *"
SLA_AMAZON_FIRST_RESPONSE_MINUTES=1440   # 24h corridas (internal target 18h)
SLA_AMAZON_INTERNAL_TARGET_MINUTES=1080
SLA_MELI_QUESTION_MINUTES=120
SLA_MELI_CLAIM_MINUTES=1440
SLA_SHOPEE_CRR_HOURS=12
SLA_WARNING_MINUTES=120
# PII retention: Amazon restricted data must be purged 30 days after shipment.
PII_RETENTION_DAYS=30
PII_PURGE_CRON="0 */6 * * *"

# ----------------------------- Feature flags / demo --------------------------
ALLOW_DEMO_SEED=true
# Frontend runs seeded demo data when the API is unreachable.
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_WS_URL=http://localhost:4000

# ----------------------------- Local ports -----------------------------------
# Host port overrides used by docker-compose.yml. Change these when a port is
# already taken on your machine (e.g. a local PostgreSQL on 5432).
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
WEB_HOST_PORT=8080
