{
    "name": "@sac/root",
    "version": "1.0.0",
    "private": true,
    "description": "SAC Hub - Omnichannel marketplace support integrator (Amazon SP-API/SES, Mercado Livre, Shopee Open Platform v2)",
    "license": "UNLICENSED",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "engines": {
        "node": "22.x"
    },
    "scripts": {
        "build:shared": "tsc -p packages/shared/tsconfig.json",
        "build:server": "tsc -p packages/server/tsconfig.json",
        "build:web": "npm run build --workspace @sac/web",
        "build": "npm run build:shared && npm run prisma:generate && npm run build:server && npm run build:web",
        "prisma:generate": "prisma generate",
        "prisma:migrate:dev": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "db:push": "prisma db push",
        "db:seed": "prisma db seed",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
        "typecheck:shared": "tsc -p packages/shared/tsconfig.json --noEmit",
        "typecheck:server": "npm run build:shared && tsc -p packages/server/tsconfig.json --noEmit",
        "typecheck:web": "npm run typecheck --workspace @sac/web",
        "typecheck": "npm run typecheck:server && npm run typecheck:web",
        "dev:server": "npm run dev --workspace @sac/server",
        "dev:web": "npm run dev --workspace @sac/web",
        "dev": "npm run build:shared && concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
        "test": "vitest run",
        "doctor": "tsx scripts/doctor.ts",
        "validate:live": "node scripts/validate-live.mjs",
        "setup:assistant": "node scripts/setup-assistant.mjs",
        "setup:apply": "node scripts/setup-apply.mjs",
        "test:live-2fa": "node scripts/live-2fa-test.mjs",
        "test:live-sso": "node scripts/live-sso-test.mjs",
        "test:live-socket": "node scripts/live-socket-revoke-test.mjs",
        "test:live-2fa-policy": "node scripts/live-2fa-policy-test.mjs",
        "security:probe": "node scripts/security-probe.mjs",
    "sso:doctor": "node scripts/sso-doctor.mjs",
        "test:isolation": "node scripts/isolation-test.mjs",
        "db:up": "docker compose up -d postgres redis minio minio-init mailpit",
        "db:down": "docker compose down",
        "docker:up": "docker compose up -d --build"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "axe-core": "^4.14.0",
        "concurrently": "^9.1.0",
        "prisma": "^7.10.1",
        "puppeteer-core": "^25.16.0",
        "s3rver": "^3.7.1",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "vitest": "^2.1.8"
    },
    "homepage": "https://integrai-dev.vercel.app",
    "repository": {
        "type": "git",
        "url": "https://github.com/xploryngDAO/IntegrAI.git"
    },
    "dependencies": {
        "dotenv": "^16.6.1"
    }
}
