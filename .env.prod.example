# Copie para .env.prod e preencha. NUNCA commite .env.prod.
# Gere segredos:
#   JWT_SECRET:  openssl rand -hex 32
#   ENCRYPTION_MASTER_KEY: openssl rand -base64 32  (32 bytes em base64)
POSTGRES_USER=sac
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sac_hub
POSTGRES_HOST_PORT=55433

REDIS_HOST_PORT=56380

MINIO_ROOT_USER=sac-minio
MINIO_ROOT_PASSWORD=troque-esta-senha-minio-16+
MINIO_HOST_PORT=4900
MINIO_CONSOLE_PORT=4901

JWT_SECRET=troque-por-64-hex
JWT_EXPIRES_IN=1h
ENCRYPTION_MASTER_KEY=troque-por-base64-de-32-bytes
ENCRYPTION_KEY_ID=prod-v1

API_HOST_PORT=4105
WEB_ORIGIN=https://integrai-dev.vercel.app

# Seed do primeiro administrador (npm run db:seed)
ADMIN_EMAIL=admin@suaempresa.com
ADMIN_PASSWORD=troque-esta-senha-forte
ADMIN_NAME=Administrador

# Object storage externo compatível com S3 (AWS S3, MinIO, R2, s3rver)
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=sac-hub-raw
S3_ATTACHMENTS_BUCKET=sac-hub-attachments
S3_ACCESS_KEY_ID=troque
S3_SECRET_ACCESS_KEY=troque
S3_FORCE_PATH_STYLE=false
WEB_HOST_PORT=8080
# Perfil TLS (Caddy): dominio publico que aponta para o host
DOMAIN=integrai.example.com
# Observabilidade (perfil opcional)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=troque-esta-senha
# Token do /api/v1/metrics (vazio = endpoint desabilitado)
METRICS_TOKEN=
